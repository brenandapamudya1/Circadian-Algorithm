{
  "expo": {
    "name": "Bypolizer",
    "slug": "bypolizer",
    "owner": "zendata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/larger_icon_app.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bipolyzer.circadian",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/larger_icon_app.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/larger_icon_app.png"
    },
    "extra": {
      "eas": {
        "projectId": "b5471de8-d641-4702-bcd4-0eb6ea8ae371"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothNeverForLocationPermissionDescription": "Aplikasi Bypolizer membutuhkan Bluetooth untuk terhubung ke sensor sirkadian."
        }
      ]
    ]
  }
}
